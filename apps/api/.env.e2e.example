# E2E environment for apps/api. Copy to .env.e2e and fill in real local values.
# Loaded explicitly via `dotenv -e .env.e2e` by the e2e scripts — Expo and Next
# never read this file.
#
# THREE VALUES ARE NOT FREE CHOICES. The destructive-seed guard in
# test/e2e/helpers/seed-ui.ts refuses to run unless all three hold:
#   NODE_ENV=test
#   DB_NAME matches /e2e/i
#   REDIS_URL carries an explicit, non-zero database index
# Get one wrong and `pnpm e2e:seed:ui` aborts instead of touching your dev data.

# Server
NODE_ENV=test
PORT=3011

# Database — DB_NAME must contain "e2e" or the seed guard refuses
DB_HOST=localhost
DB_PORT=54320
DB_USER=yappie
DB_PASSWORD=yappie
DB_NAME=yappie_e2e

# Redis — needs an explicit non-zero DB index (/15), not /0 and not bare
REDIS_URL=redis://localhost:6379/15

# JWT
JWT_SECRET=e2e-only-secret-not-a-real-one
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OpenAI — unused while E2E_MOCK_AI=true (ai.module returns FakeAIService, so
# AIService is never constructed), but the Zod schema still requires non-empty
OPENAI_API_KEY=unused-while-e2e-mock-ai-is-true
AI_TRANSCRIPTION_MODEL=unused-while-e2e-mock-ai-is-true
AI_DECOMPOSITION_MODEL=unused-while-e2e-mock-ai-is-true
AI_GENERATION_MODEL=unused-while-e2e-mock-ai-is-true

# Storage — keep separate from the dev upload dir
UPLOAD_PATH=./uploads-e2e

# Frontend
FRONTEND_URL=http://localhost:3000

# Encryption — exactly 64 hex characters. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# Email — unused while E2E_TEST_ENDPOINTS=true (email.module returns
# FakeEmailService), but the Zod schema still requires non-empty
RESEND_API_KEY=unused-while-e2e-test-endpoints-is-true
EMAIL_FROM=e2e@example.com

# Quotas
QUOTA_FREE_MINUTES=20
QUOTA_PRO_MINUTES=300

# E2E flags — both must be true for the UI smoke. Boot validation FAILS if
# either is true while NODE_ENV=production.
#   E2E_TEST_ENDPOINTS=true  exposes the guarded OTP-read endpoint and swaps in
#                            FakeEmailService
#   E2E_MOCK_AI=true         swaps in FakeAIService, which returns exactly two
#                            deterministic tickets the smoke asserts on
E2E_TEST_ENDPOINTS=true
E2E_MOCK_AI=true

# Optional — omit entirely for e2e. Listed so this file stays the full picture.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# JIRA_CALLBACK_URL=
# SENTRY_DSN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
